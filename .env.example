# ── Required ───────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey
# Powers Find (product search), "Where is this from?" and room previews — one key, three features.
GEMINI_API_KEY=

# Shown across the site
HOUSE_NAME=Christy’s House

# The secret part of the invite link: {PUBLIC_BASE_URL}/join/{INVITE_CODE}
# Make it long and random. Anyone with the link can get in; change it to lock people out.
INVITE_CODE=

# The site's public address, e.g. https://christys-house.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# ── Storage (added for you by Vercel) ──────────────────────
# Neon Postgres (Vercel → Storage → Neon). Leave unset locally to use a JSON file.
DATABASE_URL=
# Vercel Blob (Vercel → Storage → Blob, choose "Private"). Holds photos and scans.
BLOB_READ_WRITE_TOKEN=

# ── Where you live: steers search results and Marketplace links ──
HOME_COUNTRY=GB
HOME_CITY=London
CURRENCY=GBP
MARKETPLACE_CITY=london

# ── Optional extras ────────────────────────────────────────
# Which Gemini model does the product search and "Where is this from?" lookups.
# gemini-3.5-flash is the default; gemini-3.5-flash-lite is cheaper but less thorough.
GEMINI_SEARCH_MODEL=gemini-3.5-flash
# Which Gemini model renders "see it in my room" previews.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Texting (Twilio SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALLOWED_PHONE_NUMBERS=+447700900000
